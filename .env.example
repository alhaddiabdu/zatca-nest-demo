# ===== البيئة =====
# developer-portal : بوابة المطورين (تجربة حرة بدون تسجيل، أي OTP يعمل مثل 123345)
# simulation       : بيئة المحاكاة (تحتاج OTP حقيقي من بوابة فاتورة - المحاكاة)
# core             : الإنتاج الحقيقي
ZATCA_ENV=developer-portal
PORT=3000

# ===== بيانات المنشأة (البائع) =====
SELLER_NAME=شركة التجربة المحدودة
SELLER_VAT=399999999900003
SELLER_CRN=1010010000
SELLER_STREET=الأمير سلطان
SELLER_BUILDING=2322
SELLER_DISTRICT=المربع
SELLER_CITY=الرياض
SELLER_POSTAL=23333

# ===== بيانات وحدة إصدار الفواتير (EGS) لطلب الشهادة CSR =====
EGS_COMMON_NAME=TST-886431145-399999999900003
EGS_ORG_UNIT=Riyadh Branch
EGS_SOLUTION_NAME=MyERP
EGS_MODEL=NestDemo
EGS_SERIAL=ed22f1d8-e6a2-1118-9b58-d9a8f11e445f
# 1100 = فواتير قياسية (B2B) + مبسطة (B2C) | 1000 = قياسية فقط | 0100 = مبسطة فقط
EGS_INVOICE_TYPE=1100
EGS_LOCATION=RRRD2929
EGS_INDUSTRY=Supply activities

# مكان حفظ المفاتيح والشهادات وسلسلة الفواتير (للتجربة فقط!)
DATA_DIR=./data
