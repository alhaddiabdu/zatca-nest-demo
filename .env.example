# ===== الخادم =====
PORT=3000

# ===== مفتاح تشفير الأسرار في القاعدة (إلزامي) =====
# أضفه بالأمر: echo "MASTER_KEY=$(openssl rand -base64 32)" >> .env
# احفظ نسخة منه خارج الخادم: ضياعه يعني ضياع المفاتيح الخاصة وإعادة التسجيل.
# MASTER_KEY=

# ===== الاتصال بالهيئة =====
# fake : ردود محلية بدون أي اتصال بالهيئة (للتطوير والاختبار)
# live : الاتصال الحقيقي بمنصة فاتورة حسب الوضع المختار في الواجهة
ZATCA_TRANSPORT=fake

# ===== قاعدة البيانات PostgreSQL =====
POSTGRES_DB=zatca
POSTGRES_USER=zatca
POSTGRES_PASSWORD=change-me
# من جهازك (المنفذ 5433). داخل docker-compose يُستبدل تلقائياً بالمضيف postgres
DATABASE_URL=postgres://zatca:change-me@localhost:5433/zatca
# قاعدة منفصلة لاختبارات التكامل (يجب أن ينتهي اسمها بـ _test)
TEST_DATABASE_URL=postgres://zatca:change-me@localhost:5433/zatca_test
# تطبيق الـ migrations عند الإقلاع (false لتطبيقها يدوياً بـ npm run migration:run)
DB_MIGRATIONS_RUN=true

# ===== إعادة الإرسال التلقائية =====
# كل 5 دقائق للفواتير المعلّقة (false لإيقافها)
RETRY_SCHEDULER_ENABLED=true

# ===== للاستيراد من النسخة القديمة فقط (npm run import:json) =====
# بيانات المنشأة والـ EGS صارت تُدخل من شاشة الإعدادات لكل وضع.
# هذه القيم تُطبَّق عند الاستيراد على الوضع المذكور في ZATCA_ENV فقط.
# ZATCA_ENV=developer-portal
# DATA_DIR=./data
# SELLER_NAME=
# SELLER_VAT=
# SELLER_CRN=
# SELLER_STREET=
# SELLER_BUILDING=
# SELLER_DISTRICT=
# SELLER_CITY=
# SELLER_POSTAL=
# EGS_COMMON_NAME=
# EGS_ORG_UNIT=
# EGS_SOLUTION_NAME=
# EGS_MODEL=
# EGS_SERIAL=
# EGS_INVOICE_TYPE=1100
# EGS_LOCATION=
# EGS_INDUSTRY=
